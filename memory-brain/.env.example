# 🔴 MongoDB Configuration (Required for Production)
# Compose service is named `mongo` (memory-brain/docker-compose.yml), not `mongodb`
MONGODB_URL=mongodb://mongo:27017
DATABASE_NAME=ai_dost_memory

# 🔴 Redis Configuration (Required for Caching)
# P3 #213: the bundled compose runs `redis-server --requirepass
# ${REDIS_PASSWORD:-change_me_redis}` — a password-less URL can never connect.
# Keep in sync with REDIS_PASSWORD (default matches the compose default).
REDIS_URL=redis://:change_me_redis@redis:6379
REDIS_PASSWORD=change_me_redis

# 🔴 Application Config
# P3 #212: app/main.py reads CORS_ORIGINS (settings.CORS_ORIGINS) only — the
# old FRONTEND_URL entry was never read, so CORS could not be overridden from
# this file.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000,http://127.0.0.1:3001
# JWT signing secret (#180) — generate one, never commit the real value:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# If left empty, an ephemeral per-process key is used (JWTs reset on restart).
SECRET_KEY=generate_a_strong_secret_key_here

# 🔴 LLM API Keys (Highly Recommended)
# Get from: https://console.groq.com/keys
GROQ_API_KEY=your_groq_key_here
# Get from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_key_here
NVIDIA_API_KEY=your_nvidia_key_here
