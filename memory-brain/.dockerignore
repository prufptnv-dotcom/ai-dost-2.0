# Secrets — never bake into the image (#179)
.env
.env.*
!.env.example

# Python caches / tooling
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.venv/
venv/

# VCS / logs
.git/
.gitignore
*.log

# Tests are not part of the runtime image
tests/

