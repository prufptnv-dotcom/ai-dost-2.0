# AI-Dost v2.0 Free API Configuration
# 100% free APIs - no paid services required

# Google Gemini API (free: 1500 requests/day)
GEMINI_API_KEY=your_gemini_api_key_here

# Tavily Search API (free: 1000 searches/month)
# Or use SearXNG self-hosted instance (no key required)
TAVILY_API_KEY=your_tavily_api_key_here

# Optional: OpenRouter for model routing
OPENROUTER_API_KEY=your_openrouter_key_here

# Optional: Cerebras Inference (free: 1M tokens/day, no credit card)
# Get key from https://cloud.cerebras.ai -> API Keys
CEREBRAS_API_KEY=your_cerebras_key_here

# Optional: Telegram Bot (100% free, phone se AI-Dost control)
# BotFather (https://t.me/BotFather) se token lo -> /newbot
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
# Optional: sirf in chat IDs ko allow karo (comma separated). Khali = sab allowed
TELEGRAM_ALLOWED_IDS=

# Ollama Local Model Configuration
# Requires 16GB+ RAM for 7b parameter models
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:7b  # or deepseek-coder:6.7b

# Application Settings
NEXT_PUBLIC_APP_URL=http://localhost:3001
# API base URL - set to /api/v1 for development, or http://localhost:5000 for production with proxy
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1

# Development Mode
NODE_ENV=development