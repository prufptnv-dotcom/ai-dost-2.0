# ==========================================
# AI-DOST PRODUCTION ENVIRONMENT VARIABLES
# ==========================================
# Copy this file to '.env' on your production server.
# NEVER commit the actual '.env' file to version control.

# ------------------------------------------
# 1. SECURITY (CRITICAL)
# ------------------------------------------
# Generate a random 32-character string for production (e.g. openssl rand -hex 32)
SECRET_KEY=replace_this_with_a_highly_secure_random_string

# Comma-separated list of allowed origins. Add your production frontend URL here.
# Example: https://ai-dost.vercel.app,https://my-custom-domain.com
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ------------------------------------------
# 2. FRONTEND CONFIG
# ------------------------------------------
# URL of your production backend API (used by frontend in browser)
NEXT_PUBLIC_API_URL=https://api.ai-dost.com

# Internal Docker network URL (used during Next.js server-side rendering/build)
BACKEND_INTERNAL_URL=http://backend:5005

# ------------------------------------------
# 3. DATABASE & INFRASTRUCTURE
# ------------------------------------------
# MongoDB Connection String (e.g., MongoDB Atlas)
MONGODB_URL=mongodb://mongodb:27017
DATABASE_NAME=ai_dost_memory

# Redis Connection String (e.g., Render Redis, Upstash)
REDIS_URL=redis://redis:6379

# ------------------------------------------
# 4. AI & THIRD-PARTY APIS
# ------------------------------------------
# Add your API keys below for the AI models you plan to use
GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
DEEPSEEK_API_KEY=
NVIDIA_API_KEY=
OPENROUTER_API_KEY=
