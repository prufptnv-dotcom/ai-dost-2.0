# AI-Dost v2.0 Free API Configuration
# 100% free APIs - no paid services required
#
# NOTE: the backend loads backend/.env (dotenv.config path = backend/.env).
# Copy this file to BOTH the repo root (used by docker-compose env_file) and
# backend/.env (used by node server.js) — or keep keys only in backend/.env.

# Backend server port
PORT=5000

# Google Gemini API (free: 1500 requests/day)
GEMINI_API_KEY=your_gemini_api_key_here

# LLM provider keys (backend cascade order: Groq → Gemini → ... → OpenRouter)
# Exact env var names as read by backend/services/*
GROQ_API_KEY=
DEEPSEEK_API_KEY=
HUGGINGFACE_API_KEY=
NVIDIA_API_KEY=
MISTRAL_API_KEY=
TOGETHER_API_KEY=
OPENAI_API_KEY=

# Tavily Search API (free: 1000 searches/month)
# Or use SearXNG self-hosted instance (no key required)
TAVILY_API_KEY=your_tavily_api_key_here

# Optional: OpenRouter for model routing
OPENROUTER_API_KEY=your_openrouter_key_here

# Optional: Cerebras Inference (free: 1M tokens/day, no credit card)
# Get key from https://cloud.cerebras.ai -> API Keys
CEREBRAS_API_KEY=your_cerebras_key_here

# Optional: Telegram Bot (100% free, phone se AI-Dost control)
# BotFather (https://t.me/BotFather) se token lo -> /newbot
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
# Optional: sirf in chat IDs ko allow karo (comma separated). Khali = sab allowed
TELEGRAM_ALLOWED_IDS=

# Ollama Local Model Configuration
# Requires 16GB+ RAM for 7b parameter models
# P3 #191: OLLAMA_HOST is what the backend actually reads (chat.js,
# geminiService.js, agent.js — full URL or bare host[:port]). The old
# OLLAMA_BASE_URL name was read by nothing. In Docker point it at the host:
#   OLLAMA_HOST=http://host.docker.internal:11434
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:7b  # or deepseek-coder:6.7b

# Figma MCP (optional) — /api/figma/* returns 503 FIGMA_NO_KEY without it
# (P3 #192: was missing from this example entirely)
FIGMA_API_KEY=

# Python AI engine bridge (optional, http://127.0.0.1:8001)
# P3 #193: routes/agent.js reads PYTHON_AI_ENGINE_URL first, then AI_ENGINE_URL
# (docker-compose sets AI_ENGINE_URL=...), then falls back to 127.0.0.1:8001.
PYTHON_AI_ENGINE_URL=http://127.0.0.1:8001
# AI_ENGINE_URL=http://localhost:8001

# Frontend build-time config (P3 #208/#209)
# NEXT_PUBLIC_* vars are inlined at build — docker-compose passes them as
# build args (see docker-compose.yml frontend build.args). The browser client
# uses the same-origin /api/v1 rewrite proxy by default, so you normally do
# NOT need any of these; cross-origin values only add a CORS dependency.
# NEXT_PUBLIC_BACKEND_URL=http://localhost:5000
# NEXT_PUBLIC_GO_WS_URL=ws://localhost:5000

# Backend production runtime hardening
# Comma-separated browser origins. In production, do not leave this empty or use '*'.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Optional single-origin fallback when CORS_ORIGINS is not set.
FRONTEND_URL=http://localhost:3000
# Default JSON body limit. Keep small and use large-route prefixes only where required.
JSON_BODY_LIMIT=2mb
JSON_LARGE_BODY_LIMIT=50mb
JSON_LARGE_ROUTE_PREFIXES=/api/image,/api/v1/image,/api/pdf,/api/v1/pdf
# Maximum simultaneous AI requests for the in-memory queue.
MAX_CONCURRENT_AI=20

# Development Mode (host runs: cd backend && node server.js)
# P3 #190: docker-compose forces NODE_ENV=production for the backend container
# regardless of this value (opt back into dev per-container with
# BACKEND_NODE_ENV=development in the compose interpolation env).
NODE_ENV=development

# -- P10.1: OpenCode free gateway (no API key needed) --------------------------
# Routes AI-Dost LLM calls through the locally installed OpenCode server.
# Uses OpenCode's platform gateway (9 free models, cost 0). Set to false to disable.
OPENCODE_ENABLED=true
# Preferred headless server port (auto-reused across backend restarts via a temp state file)
OPENCODE_PORT=4789
# Default model: provider/model (free platform gateway models end in -free)
OPENCODE_MODEL=opencode/mimo-v2.6-flash-free
# Per-request timeout (ms)
OPENCODE_TIMEOUT_MS=60000
# Optional: override binary resolution if opencode is not on PATH / npm dir
# OPENCODE_BIN=C:\path\to\opencode.exe
